{
  "name": "driiva-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Driiva telematics app",
  "main": "lib/index.js",
  "scripts": {
    "prebuild": "npm run build --prefix ../packages/contracts && tsc -p tsconfig.contracts.json && cp ../shared/tripProcessor.ts src/shared/tripProcessor.ts && cp ../packages/scoring/src/tripMetrics.ts src/scoring/tripMetrics.ts && cp ../packages/scoring/src/refund.ts src/scoring/refund.ts",
    "build": "npm run prebuild && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint --ext .js,.ts .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "export-firestore": "npm run build && node lib/scripts/exportFirestore.js"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@driiva/contracts": "file:vendor/contracts",
    "@neondatabase/serverless": "^0.10.4",
    "@sentry/node": "^10.70.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^5.0.0",
    "node-fetch": "^2.7.0",
    "ws": "^8.18.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.6.11",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "private": true
}
