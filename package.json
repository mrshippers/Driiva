{
  "name": "driiva",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=development doppler run -- tsx server/index.ts",
    "dev:staging": "NODE_ENV=development tsx --env-file=.env.staging server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:staging": "vite build --mode staging && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:packages": "npm run build --prefix packages/contracts && npm run build --prefix packages/scoring",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "check:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:integration": "firebase emulators:exec --only auth,firestore \"vitest run --config vitest.integration.config.ts\"",
    "test:auth": "node test-auth.js",
    "create:user": "node create-user.js",
    "create-firebase-test-users": "tsx scripts/create-firebase-test-users.ts",
    "verify:db": "tsx scripts/verify-db.ts",
    "db:schema": "tsx scripts/run-schema.ts",
    "load-test": "tsx scripts/load-test.ts",
    "test:root-api": "tsx scripts/test-root-api.ts",
    "export-firestore": "cd functions && npm run export-firestore",
    "design:laws": "node tests/design-laws.mjs",
    "design:laws:plant": "PLANT_VIOLATION=1 node tests/design-laws.mjs",
    "design:laws:mobile": "node tests/mobile-source-laws.mjs",
    "design:laws:mobile:plant": "PLANT_VIOLATION=1 node tests/mobile-source-laws.mjs",
    "fabrication:laws": "node tests/fabrication-laws.mjs",
    "fabrication:laws:plant": "PLANT_VIOLATION=1 node tests/fabrication-laws.mjs",
    "qa:seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9098 GCLOUD_PROJECT=driiva node scripts/seed-qa-emulator.mjs",
    "qa:emulators": "firebase emulators:start --only auth,firestore --config firebase.qa.json --project driiva",
    "axe": "node tests/axe-audit.mjs",
    "motion:reduced": "node tests/marketing-reduced-motion.mjs",
    "motion:reduced:plant": "PLANT_VIOLATION=1 node tests/marketing-reduced-motion.mjs",
    "gates": "./scripts/run-gates.sh",
    "verify:beta": "node scripts/verify-beta.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
