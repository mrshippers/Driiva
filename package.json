    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.69.0",
    "@simplewebauthn/server": "^13.2.1",
    "@stripe/react-stripe-js": "^3.7.0",
